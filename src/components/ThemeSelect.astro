---
import Select from '@astrojs/starlight/components/Select.astro';
---

{/*
  Same as Starlight's theme select, except that dark is the default and an
  explicit "Auto" choice is stored as "auto" so it can be told apart from
  no choice at all.
*/}
<starlight-theme-select>
	<Select
		icon="moon"
		label={Astro.locals.t('themeSelect.accessibleLabel')}
		options={[
			{ label: Astro.locals.t('themeSelect.dark'), selected: true, value: 'dark' },
			{ label: Astro.locals.t('themeSelect.light'), selected: false, value: 'light' },
			{ label: Astro.locals.t('themeSelect.auto'), selected: false, value: 'auto' },
		]}
		width="6.25em"
	/>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Uses global scope from ThemeProvider.astro. */}
<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light';

	const storageKey = 'starlight-theme';

	/** Unknown or missing values mean dark, the default. */
	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'light' ? theme : 'dark';

	const loadTheme = (): Theme => {
		try {
			return parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));
		} catch {
			return 'dark';
		}
	};

	function storeTheme(theme: Theme): void {
		try {
			if (typeof localStorage !== 'undefined') localStorage.setItem(storageKey, theme);
		} catch {
			/* storage unavailable: the choice lasts for this page only */
		}
	}

	const resolveTheme = (theme: Theme): 'dark' | 'light' =>
		theme === 'auto'
			? matchMedia('(prefers-color-scheme: light)').matches
				? 'light'
				: 'dark'
			: theme;

	function applyTheme(theme: Theme): void {
		StarlightThemeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = resolveTheme(theme);
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') applyTheme('auto');
	});

	class SceneryThemeSelect extends HTMLElement {
		constructor() {
			super();
			applyTheme(loadTheme());
			this.querySelector('select')?.addEventListener('change', (e) => {
				if (e.currentTarget instanceof HTMLSelectElement) {
					const theme = parseTheme(e.currentTarget.value);
					storeTheme(theme);
					applyTheme(theme);
				}
			});
		}
	}
	customElements.define('starlight-theme-select', SceneryThemeSelect);
</script>
